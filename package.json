{
  "name": "eslint-plugin-ocavue",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "description": "Custom ESLint rules from ocavue",
  "author": "ocavue <ocavue@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/ocavue/eslint-plugin-ocavue#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocavue/eslint-plugin-ocavue.git"
  },
  "bugs": "https://github.com/ocavue/eslint-plugin-ocavue/issues",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxfmt && pnpm run lint:knip",
    "lint:oxfmt": "oxfmt --check",
    "lint:eslint": "eslint",
    "lint:knip": "knip",
    "fix": "pnpm run fix:oxfmt && pnpm run fix:eslint",
    "fix:oxfmt": "oxfmt",
    "fix:eslint": "eslint --fix",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.20.2",
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
